# 数据库连接。默认 SQLite 零配置即可运行;切换 PostgreSQL 改为:
# DATABASE_URL="postgresql://user:pass@localhost:5432/youth_ai_nav"
# 并把 prisma/schema.prisma 中 datasource provider 改为 "postgresql"
DATABASE_URL="file:./dev.db"

# 会话签名密钥,生产环境必须更换为强随机值
AUTH_SECRET=change-me-to-a-long-random-string

APP_BASE_URL=http://localhost:3000

# GLM 接入(只会在服务端使用,绝不下发到浏览器)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=glm-5.3
LLM_PROVIDER=glm

# 无 API Key 或设为 true 时,自动使用 Mock Provider,可完整演示
LLM_MOCK_MODE=false

# 只有由 Cloudflare 等受信任代理覆盖客户端地址头时才设为 true。
# 默认使用同源共享限流桶，避免直接信任可伪造的 X-Forwarded-For。
HUB_COACH_TRUST_PROXY=false

# 公共 Coach 每日真实出站上限(本地日切重置;超出后回退确定性 fixture)。
# 正数=上限;"0"=显式不限;未设置=默认 500。
HUB_COACH_DAILY_LIMIT=500

# 附件上传大小上限(MB)
UPLOAD_MAX_MB=10

# MiniMax 生图(里程碑插画盲盒);无Key时自动回退离线SVG艺术
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat
MINIMAX_MODEL=image-01
